{
  "sentinel": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/sentinel.py pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/sentinel.py post",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./scripts/sentinel.py stop",
        "timeout": 15
      }
    ]
  },
  "operator-crucible": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/operator_router.py session-start",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./scripts/operator_router.py pre-invocation",
        "timeout": 5
      }
    ]
  }
}
