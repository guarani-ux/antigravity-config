{
  "sentinel": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|run_command|command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ \"__CONFIG_DIR__/scripts/sentinel.py\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|view_file|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|run_command|command|call_mcp_tool|mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ \"__CONFIG_DIR__/scripts/sentinel.py\" post",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ \"__CONFIG_DIR__/scripts/sentinel.py\" stop",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "operator-router": {
    "enabled": true,
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ \"__CONFIG_DIR__/scripts/operator_router.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PYTHON__ \"__CONFIG_DIR__/scripts/operator_router.py\" pre-invocation",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
